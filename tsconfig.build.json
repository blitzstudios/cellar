{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "sourceMap": true,
    // `./testing` is jest fixtures, so its declarations name jest's own globals.
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["src/**/tests/**", "src/**/*.test.ts", "src/**/*.probe.ts"]
}
